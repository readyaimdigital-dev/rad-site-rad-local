# Resend API key (server-only, never exposed to the browser).
RESEND_API_KEY=

# Mailbox that receives contact-form submissions.
CONTACT_TO_EMAIL=

# Verified Resend "from" sender address (e.g. hello@yourdomain.com.au).
RESEND_FROM_EMAIL=

# GA4 measurement ID. Leave blank to disable analytics entirely; no
# analytics script is rendered when this is unset.
PUBLIC_GA4_ID=

# Static build attribution. Whitelabel is the fail-safe default. For a direct
# build, set all three values and use an HTTP(S) attribution URL.
PUBLIC_BUILD_TYPE=whitelabel
PUBLIC_ATTRIBUTION_LABEL=
PUBLIC_ATTRIBUTION_URL=
