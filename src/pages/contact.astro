---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ui/ContactForm.astro";
import ContactSplit from "../components/sections/ContactSplit.astro";
import { site } from "../config/site";
import { content } from "../config/content";

const { contact } = content;
const telHref = `tel:${site.contact.phone.replace(/\s+/g, "")}`;
const fullAddress = [
  site.address.street,
  `${site.address.suburb} ${site.address.state} ${site.address.postcode}`,
]
  .filter(Boolean)
  .join(", ");
const trustItems = content.trustPillars.map((pillar) => ({
  icon: pillar.icon,
  label: pillar.title,
  sub: pillar.body,
}));
---

<BaseLayout title={content.contact.title} description={content.contact.description}>
  <ContactSplit
    heading={contact.heading}
    intro={contact.intro}
    details={{
      phone: { href: telHref, display: site.contact.phone },
      email: { href: `mailto:${site.contact.email}`, display: site.contact.email },
      address: fullAddress,
      detailsEyebrow: contact.detailsEyebrow,
      phoneEyebrow: contact.phoneEyebrow,
      phoneNote: contact.phoneNote,
      trustEyebrow: contact.trustEyebrow,
      trustItems,
      areaEyebrow: contact.areaEyebrow,
      areaText: site.serviceArea.join(" · "),
    }}
  >
    <ContactForm />
  </ContactSplit>
</BaseLayout>
