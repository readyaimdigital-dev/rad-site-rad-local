---
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/ui/Card.astro";
import { content } from "../config/content";
---

<BaseLayout title={content.servicesPage.title} description={content.servicesPage.description}>
  <section class="section">
    <div class="container">
      <h1>{content.servicesPage.heading}</h1>
      <p class="text-muted">{content.servicesPage.intro}</p>
      <div class="grid">
        {
          content.services.map((service) => (
            <Card title={service.title}>
              <p>{service.body}</p>
            </Card>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
</style>
