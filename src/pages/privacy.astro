---
import BaseLayout from "../layouts/BaseLayout.astro";
import { content } from "../config/content";
---

<BaseLayout title={content.privacy.title} description={content.privacy.description} noindex>
  <section class="section">
    <div class="container">
      <h1>{content.privacy.heading}</h1>

      <div class="legal-notice">
        <strong>{content.privacy.notice.label}</strong> {content.privacy.notice.body}
      </div>

      <p class="text-muted">{content.privacy.lastUpdated}</p>

      {
        content.privacy.sections.map((section) => (
          <>
            <h2>{section.heading}</h2>
            <p>
              {section.body}
              {section.email && (
                <>
                  {" "}<a href={`mailto:${section.email}`}>{section.email}</a>.
                </>
              )}
            </p>
          </>
        ))
      }
    </div>
  </section>
</BaseLayout>
