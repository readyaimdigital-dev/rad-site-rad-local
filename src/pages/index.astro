---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSplit from "../components/sections/HeroSplit.astro";
import FeatureGrid from "../components/sections/FeatureGrid.astro";
import StorySplit from "../components/sections/StorySplit.astro";
import GalleryMosaic from "../components/sections/GalleryMosaic.astro";
import ServiceAreaSplit from "../components/sections/ServiceAreaSplit.astro";
import CtaBand from "../components/sections/CtaBand.astro";
import { site } from "../config/site";
import { content, getFeaturedServices } from "../config/content";

const featuredServices = getFeaturedServices().map((service) => ({
  icon: service.icon,
  title: service.title,
  body: service.body,
}));
---

<BaseLayout>
  <HeroSplit
    eyebrow={content.home.hero.eyebrow}
    heading={content.home.hero.heading}
    headlineAccent={content.home.hero.headlineAccent}
    lead={content.home.hero.intro}
    primaryCta={{ label: content.home.hero.primaryCta, href: "/contact" }}
    secondaryCta={{ label: content.home.hero.secondaryCta, href: "/services" }}
    facts={content.home.hero.facts}
    image={content.home.hero.image}
  />

  <FeatureGrid heading={content.home.servicesHeading} items={featuredServices} surface="surface" />

  <FeatureGrid
    eyebrow={content.home.why.eyebrow}
    heading={content.home.why.heading}
    items={content.trustPillars}
  />

  <StorySplit
    as="h2"
    eyebrow={content.home.ownerIntro.eyebrow}
    heading={content.home.ownerIntro.heading}
    body={content.home.ownerIntro.body}
    image={content.home.ownerIntro.image}
    imageSide="left"
    primaryCta={{ label: content.home.ownerIntro.ctaLabel, href: "/about" }}
  />

  <GalleryMosaic
    id="work"
    eyebrow={content.home.gallery.eyebrow}
    heading={content.home.gallery.heading}
    intro={content.home.gallery.intro}
    images={content.home.gallery.images}
  />

  <ServiceAreaSplit
    eyebrow={content.home.serviceAreaEyebrow}
    heading={content.home.serviceAreaHeading}
    lead={`${content.home.serviceAreaIntro} ${site.serviceArea.join(", ")} ${content.home.serviceAreaSuffix}`}
    areas={site.serviceArea}
    image={content.home.serviceAreaImage}
  />

  <CtaBand
    heading={content.home.cta.heading}
    sub={content.home.cta.sub}
    ctaLabel={content.home.cta.ctaLabel}
    href="/contact"
  />
</BaseLayout>
