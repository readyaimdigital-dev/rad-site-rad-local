<script>
  /* FAQ accordion. Disclosure pattern, not a tablist: native button semantics
     and Tab are correct, so no arrow keys and no roving tabindex. Panels stay
     in the DOM and toggle `hidden`, so aria-controls never dangles. (09 §2) */
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.faq__button'));

  function setOpen(btn: HTMLButtonElement, open: boolean) {
    const panel = document.getElementById(btn.getAttribute('aria-controls') || '');
    btn.setAttribute('aria-expanded', String(open));
    const sign = btn.querySelector('.faq__sign');
    if (sign) sign.textContent = open ? '–' : '+';
    if (panel) panel.hidden = !open;
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      buttons.forEach((b) => setOpen(b, false));  // single-open
      if (!isOpen) setOpen(btn, true);
    });
  });
</script>
