---
interface Props { variant?: 'outline' | 'solid' | 'teal' | 'inverse'; class?: string }
const { variant = 'outline', class: className } = Astro.props;
---
<span class:list={['chip', `chip--${variant}`, className]}><slot /></span>
<style>
  .chip{
    font-family:var(--font-mono);font-size:var(--text-mono);
    letter-spacing:var(--tracking-chip);padding:6px 14px;
    border-radius:var(--radius-pill);display:inline-block;white-space:nowrap;
    border:1.5px solid var(--ink);color:var(--ink);
  }
  /* solid uses --fill-accent, not --orange: white on it is 6.41:1 */
  .chip--solid{background:var(--fill-accent);color:var(--white);border:var(--rule) solid var(--fill-accent)}
  .chip--teal{border:1.5px solid var(--border-teal);color:var(--eucalypt-deep)}
  .chip--inverse{border:1.5px solid var(--paper);color:var(--paper)}
</style>
