---
/** FoundMark — the RAD Local pin-target mark.
 *  Decorative by default: adjacent text always carries the meaning (09 §5). */
interface Props { tone?: 'ink' | 'paper' | 'onOrange'; size?: number; class?: string }
const { tone = 'ink', size = 44, class: className } = Astro.props;
const stroke = tone === 'ink' ? 'var(--ink)' : 'var(--paper)';
const dot = tone === 'onOrange' ? 'var(--ink)' : 'var(--orange)';
---
<svg
  class={className}
  viewBox="0 0 86 110"
  width={size * (86 / 110)}
  height={size}
  aria-hidden="true"
  focusable="false"
  style={`--mark-stroke:${stroke};--mark-dot:${dot};flex-shrink:0;display:block`}
>
  <path d="M43 6 C22 6 8 21 8 41 C8 62 28 78 43 104 C58 78 78 62 78 41 C78 21 64 6 43 6 Z"
        fill="none" stroke="var(--mark-stroke)" stroke-width="7" />
  <circle cx="43" cy="41" r="17" fill="none" stroke="var(--mark-stroke)" stroke-width="6" />
  <circle cx="43" cy="41" r="6.5" fill="var(--mark-dot)" />
  <line x1="43" y1="15" x2="43" y2="24" stroke="var(--mark-stroke)" stroke-width="6" stroke-linecap="round" />
  <line x1="17" y1="41" x2="26" y2="41" stroke="var(--mark-stroke)" stroke-width="6" stroke-linecap="round" />
  <line x1="60" y1="41" x2="69" y2="41" stroke="var(--mark-stroke)" stroke-width="6" stroke-linecap="round" />
</svg>
