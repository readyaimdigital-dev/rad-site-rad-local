---
import type { SectionImage } from "./types";

export interface Props {
  eyebrow?: string;
  heading: string;
  lead: string;
  areas: string[];
  image: SectionImage;
  imageSide?: "left" | "right";
}

const { eyebrow, heading, lead, areas, image, imageSide = "right" } = Astro.props;
---

<section class="section service-area-split">
  <div
    class:list={[
      "container service-area-split__grid",
      imageSide === "left" && "service-area-split__grid--media-left",
    ]}
  >
    <div>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 class="service-area-split__title">{heading}</h2>
      <p class="text-muted service-area-split__lead">{lead}</p>
      <ul class="service-area-split__pins">
        {areas.map((area) => <li>{area}</li>)}
      </ul>
    </div>
    <div class="service-area-split__media">
      <img src={image.src} alt={image.alt} width="800" height="600" loading="lazy" />
    </div>
  </div>
</section>

<style>
  .service-area-split__grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: var(--space-12);
    align-items: center;
  }

  .service-area-split__grid--media-left {
    grid-template-columns: 1.4fr 1fr;
  }

  .service-area-split__grid--media-left .service-area-split__media {
    order: -1;
  }

  .service-area-split__title {
    margin: var(--space-2) 0 0;
    max-width: 22ch;
  }

  .service-area-split__lead {
    margin-top: var(--space-3);
    max-width: var(--measure-sm);
    font-size: var(--type-body-lg-size);
  }

  .service-area-split__pins {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .service-area-split__pins li {
    font-weight: 600;
    font-size: var(--type-sm-size);
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--color-surface);
    border-radius: var(--radius-pill);
    padding: var(--space-1-5) var(--space-3-5);
  }

  .service-area-split__media {
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-surface);
    aspect-ratio: 16 / 11;
  }

  .service-area-split__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 1024px) {
    .service-area-split__grid,
    .service-area-split__grid--media-left {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .service-area-split__grid--media-left .service-area-split__media {
      order: 0;
    }
  }
</style>
