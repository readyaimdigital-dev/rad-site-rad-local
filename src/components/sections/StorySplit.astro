---
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import type { Action, FeaturedImage } from "./types";

export interface Props {
  as?: "h1" | "h2";
  eyebrow?: string;
  heading: string;
  body: string | string[];
  image: FeaturedImage;
  imageSide?: "left" | "right";
  primaryCta?: Action;
  secondaryCta?: Action;
  surface?: "default" | "surface";
}

const {
  as = "h2",
  eyebrow,
  heading,
  body,
  image,
  imageSide = "left",
  primaryCta,
  secondaryCta,
  surface = "default",
} = Astro.props;

const paragraphs = Array.isArray(body) ? body : [body];
const HeadingTag = as;
---

<section class:list={["section story-split", surface === "surface" && "section--surface"]}>
  <div
    class:list={[
      "container story-split__grid",
      imageSide === "right" && "story-split__grid--media-right",
    ]}
  >
    <div class="story-split__media">
      <div class="story-split__photo">
        <img src={image.src} alt={image.alt} width="800" height="1000" loading="lazy" />
      </div>
      {
        (image.label || image.note) && (
          <div class="story-split__namecard">
            {image.label && <div class="story-split__namecard-label">{image.label}</div>}
            {image.note && <div class="story-split__namecard-note">{image.note}</div>}
          </div>
        )
      }
    </div>
    <div>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <HeadingTag class="story-split__title">{heading}</HeadingTag>
      <div class="story-split__body">
        {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      {
        (primaryCta || secondaryCta) && (
          <div class="story-split__actions">
            {primaryCta && <Button href={primaryCta.href}>{primaryCta.label}</Button>}
            {secondaryCta && (
              <a href={secondaryCta.href} class="story-split__secondary">
                {secondaryCta.label} <Icon name="arrow-right" size="17" />
              </a>
            )}
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .story-split__grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: var(--space-12);
    align-items: center;
  }

  .story-split__grid--media-right {
    grid-template-columns: 1.3fr 1fr;
  }

  .story-split__grid--media-right .story-split__media {
    order: 1;
  }

  .story-split__media {
    position: relative;
  }

  .story-split__photo {
    position: relative;
    overflow: hidden;
    background: var(--color-surface);
    border-radius: var(--radius);
    aspect-ratio: 4 / 5;
  }

  .story-split__photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .story-split__namecard {
    position: absolute;
    bottom: calc(var(--space-5) * -1);
    left: calc(var(--space-5) * -1);
    background: var(--color-bg);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-surface);
    box-shadow: var(--shadow-card);
    max-width: var(--measure-sm);
  }

  .story-split__namecard-label {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-primary);
  }

  .story-split__namecard-note {
    font-size: var(--type-sm-size);
    color: var(--color-muted);
    margin-top: var(--space-1);
  }

  .story-split__title {
    margin: var(--space-2) 0 0;
  }

  .story-split__body {
    margin-top: var(--space-5);
    max-width: var(--measure-md);
  }

  .story-split__actions {
    margin-top: var(--space-6);
    display: flex;
    gap: var(--space-4);
    align-items: center;
    flex-wrap: wrap;
  }

  .story-split__secondary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
  }

  .story-split__secondary:hover {
    color: var(--color-accent);
  }

  @media (max-width: 1024px) {
    .story-split__grid,
    .story-split__grid--media-right {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .story-split__grid--media-right .story-split__media {
      order: 0;
    }

    .story-split__photo {
      aspect-ratio: 16 / 10;
    }
  }
</style>
