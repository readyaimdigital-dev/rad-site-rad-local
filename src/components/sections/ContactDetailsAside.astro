---
import Icon from "../ui/Icon.astro";
import type { TrustItem } from "./types";

export interface Props {
  phone: { href: string; display: string };
  email?: { href: string; display: string };
  address?: string;
  detailsEyebrow?: string;
  phoneEyebrow?: string;
  phoneNote?: string;
  trustEyebrow?: string;
  trustItems?: TrustItem[];
  areaEyebrow?: string;
  areaText?: string;
}

const {
  phone,
  email,
  address,
  detailsEyebrow,
  phoneEyebrow,
  phoneNote,
  trustEyebrow,
  trustItems,
  areaEyebrow,
  areaText,
} = Astro.props;
---

<aside class="contact-details-aside">
  <div class="contact-details-aside__card contact-details-aside__card--accent">
    {phoneEyebrow && <p class="eyebrow contact-details-aside__eyebrow--on-accent">{phoneEyebrow}</p>}
    <a href={phone.href} class="contact-details-aside__phone">
      <Icon name="phone" size="22" />
      <span class="contact-details-aside__phone-num">{phone.display}</span>
    </a>
    {phoneNote && <p class="contact-details-aside__note">{phoneNote}</p>}
  </div>

  {
    (email || address) && (
      <div class="contact-details-aside__card">
        {detailsEyebrow && <p class="eyebrow">{detailsEyebrow}</p>}
        {email && (
          <a href={email.href} class="contact-details-aside__email">
            <Icon name="mail" size="18" />
            <span>{email.display}</span>
          </a>
        )}
        {address && <address class="contact-details-aside__address">{address}</address>}
      </div>
    )
  }

  {
    trustItems && trustItems.length > 0 && (
      <div class="contact-details-aside__card">
        {trustEyebrow && <p class="eyebrow">{trustEyebrow}</p>}
        <div class="contact-details-aside__trust-list">
          {trustItems.map((item) => (
            <div class="contact-details-aside__trust-item">
              {item.icon && (
                <span class="contact-details-aside__trust-icon">
                  <Icon name={item.icon} size="15" />
                </span>
              )}
              <div>
                <div class="contact-details-aside__trust-label">{item.label}</div>
                {item.sub && <div class="contact-details-aside__trust-sub">{item.sub}</div>}
              </div>
            </div>
          ))}
        </div>
      </div>
    )
  }

  {
    areaText && (
      <div class="contact-details-aside__card">
        {areaEyebrow && <p class="eyebrow">{areaEyebrow}</p>}
        <p class="contact-details-aside__area">{areaText}</p>
      </div>
    )
  }
</aside>

<style>
  .contact-details-aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .contact-details-aside__card {
    border: 1px solid var(--color-surface);
    border-radius: var(--radius);
    padding: var(--space-6);
    background: var(--color-bg);
  }

  .contact-details-aside__card--accent {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-on-accent);
  }

  .contact-details-aside__eyebrow--on-accent {
    color: var(--color-on-accent);
    opacity: 0.8;
  }

  .contact-details-aside__phone {
    display: flex;
    align-items: center;
    gap: var(--space-2-5);
    margin-top: var(--space-3);
    color: var(--color-on-accent);
    text-decoration: none;
  }

  .contact-details-aside__phone-num {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--type-display-sm-size);
  }

  .contact-details-aside__note {
    font-size: var(--type-body-sm-size);
    color: var(--color-on-accent);
    opacity: 0.85;
    margin-top: var(--space-2-5);
  }

  .contact-details-aside__email {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    color: var(--color-text);
  }

  .contact-details-aside__address {
    margin-top: var(--space-3);
    color: var(--color-muted);
    font-style: normal;
  }

  .contact-details-aside__trust-list {
    margin-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3-5);
  }

  .contact-details-aside__trust-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2-5);
  }

  .contact-details-aside__trust-icon {
    flex-shrink: 0;
    width: var(--space-7);
    height: var(--space-7);
    border-radius: var(--radius);
    border: 1.5px solid var(--color-primary);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .contact-details-aside__trust-label {
    font-weight: 600;
    font-size: var(--type-label-size);
  }

  .contact-details-aside__trust-sub {
    font-size: var(--type-sm-size);
    color: var(--color-muted);
    margin-top: var(--space-0-5);
  }

  .contact-details-aside__area {
    font-size: var(--type-body-sm-size);
    line-height: var(--type-relaxed-line-height);
    color: var(--color-text);
    margin-top: var(--space-3);
  }
</style>
