---
import Button from "../ui/Button.astro";

export interface Props {
  heading: string;
  sub?: string;
  ctaLabel: string;
  href?: string;
}

const { heading, sub, ctaLabel, href = "/contact" } = Astro.props;
---

<section class="cta-band">
  <div class="container">
    <h2 class="cta-band__title">{heading}</h2>
    {sub && <p class="cta-band__sub">{sub}</p>}
    <div class="cta-band__actions">
      <Button href={href}>{ctaLabel}</Button>
    </div>
  </div>
</section>

<style>
  .cta-band {
    background: var(--color-primary);
    color: var(--color-on-accent);
    padding: var(--space-16) 0;
    text-align: center;
  }

  .cta-band__title {
    color: var(--color-on-accent);
    margin: 0;
  }

  .cta-band__sub {
    font-size: var(--type-body-lg-size);
    color: var(--color-on-accent);
    opacity: 0.9;
    margin: var(--space-4) auto 0;
    max-width: 40ch;
  }

  .cta-band__actions {
    margin-top: var(--space-8);
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
</style>
