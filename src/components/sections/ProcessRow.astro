---
import type { ProcessStep } from "./types";

export interface Props {
  eyebrow?: string;
  heading: string;
  steps: ProcessStep[];
  dark?: boolean;
}

const { eyebrow, heading, steps, dark = false } = Astro.props;
---

<section class:list={["section process-row", dark ? "process-row--dark" : "section--surface"]}>
  <div class="container">
    <div class="section-head">
      {eyebrow && <p class:list={["eyebrow", dark && "process-row__eyebrow--on-dark"]}>{eyebrow}</p>}
      <h2 class="process-row__title">{heading}</h2>
    </div>
    <ol class="process-row__list">
      {
        steps.map((step, index) => (
          <li>
            <div class="process-row__num">{String(index + 1).padStart(2, "0")}</div>
            <h3 class="process-row__step-title">{step.title}</h3>
            <p class="process-row__step-body">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process-row--dark {
    background: var(--color-text);
    color: var(--color-bg);
  }

  .process-row__eyebrow--on-dark {
    color: var(--color-bg);
    opacity: 0.75;
  }

  .section-head {
    max-width: var(--measure-lg);
    margin-bottom: var(--space-7);
  }

  .process-row__title {
    margin: var(--space-2) 0 0;
    color: inherit;
  }

  .process-row__list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-8);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }

  .process-row__num {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: var(--type-display-lg-size);
    line-height: var(--type-display-tight-line-height);
    color: var(--color-accent);
  }

  .process-row__step-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--type-body-lg-size);
    margin: var(--space-3) 0 0;
    color: inherit;
  }

  .process-row__step-body {
    font-size: var(--type-label-size);
    line-height: var(--type-compact-line-height);
    margin: var(--space-1-5) 0 0;
    color: var(--color-muted);
  }

  .process-row--dark .process-row__step-body {
    color: var(--overlay-caption-muted);
  }

  @media (max-width: 1024px) {
    .process-row__list {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-7);
    }
  }

  @media (max-width: 560px) {
    .process-row__list {
      grid-template-columns: 1fr;
    }
  }
</style>
